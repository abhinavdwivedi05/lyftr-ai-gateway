# LiteLLM Gemini API Keys (comma-separated, at least 2 keys)
# In production, provide real Gemini API keys from Google AI Studio (e.g. AIzaSy...)
LLM_API_KEYS=placeholder_key_1,placeholder_key_2

# SQLite database URL
# In Docker, mounted at /data/app.db. In local dev outside Docker, can use sqlite:///./data/app.db
DATABASE_URL=sqlite:////data/app.db

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Failure simulation hook flag (must be true for X-Simulate-Failure to work)
ENABLE_FAILURE_SIMULATION=true

# Model name (default: gemini/gemini-flash-lite-latest)
LLM_MODEL=gemini/gemini-flash-lite-latest

# Mock provider flag for local development/testing without real keys (true/false)
MOCK_LLM=false
